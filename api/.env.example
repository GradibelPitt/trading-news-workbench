# Preferred: DeepSeek (also configurable in the AI Chat settings UI)
LLM_PROVIDER=deepseek
LLM_API_KEY=replace_with_your_key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

